# Required for AI chat functionality
# Get your API key from https://modelscope.cn
MODELSCOPE_API_KEY=your_modelscope_api_key_here

# Optional: Custom ModelScope base URL (default: https://api-inference.modelscope.cn/v1)
# MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1

# Optional: Custom SQLite database path (default: ./data/workspace.db)
# WORKSPACE_DB_PATH=/path/to/your/workspace.db

# Required for production: Site URL for SEO and canonical URLs
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
# SITE_URL=https://your-domain.com